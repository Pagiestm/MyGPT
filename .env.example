# ============================================================
# Fichier unique pour le monorepo : copier en .env à la racine
# Lu par docker compose, le serveur (NestJS) et le client (Vite)
# ============================================================

# --- Base de données (DB_HOST est forcé à "db" dans Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_DATABASE=my-gpt


# --- Sécurité
SESSION_SECRET=your-very-secure-secret-key-for-session
JWT_SECRET=your-very-secure-secret-key-for-email-verification

# --- Serveur
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Client (exposé au navigateur)
VITE_API_URL=http://localhost:3000


# --- Docker uniquement
PGADMIN_EMAIL=admin@mygpt.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
SERVER_PORT=3000
CLIENT_PORT=5173
