# ============================================================
# Fichier unique pour le monorepo : copier en .env à la racine
# Lu par docker compose, le serveur (NestJS) et le client (Vite)
# ============================================================

# --- Base de données (DB_HOST est forcé à "db" dans Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_DATABASE=my-gpt


# --- Sécurité
# Obligatoire en production, 32 caractères minimum. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Serveur
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Client (exposé au navigateur)
VITE_API_URL=http://localhost:3000


# --- Docker uniquement
PGADMIN_EMAIL=admin@mygpt.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
SERVER_PORT=3000
CLIENT_PORT=5173

# Connexion Google (optionnelle) : sans ces variables, le bouton n'apparaît pas
# Identifiants à créer sur https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Envoi de courriels : en développement, Mailpit capture tout sur http://localhost:8025
# (changez MAILPIT_PORT si ce port est déjà pris). En production, renseignez un vrai
# SMTP ; sans SMTP_HOST ni MAIL_FROM, le lien « mot de passe oublié » n'apparaît pas.
MAILPIT_PORT=8025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MyGPT <no-reply@exemple.fr>
